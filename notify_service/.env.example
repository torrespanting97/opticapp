# ── Meta WhatsApp Business Cloud API ─────────────────────────────────────
# 1. Create a Meta Business account: https://business.facebook.com
# 2. Go to Meta Developer Portal → Apps → Create App → Business
# 3. Add "WhatsApp" product
# 4. Get your Phone Number ID and generate a permanent access token

# Permanent token from Meta Business Suite → System Users → Generate token
# Permissions required: whatsapp_business_messaging, whatsapp_business_management
WA_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# Numeric Phone Number ID (NOT the phone number itself)
# Found in Meta Developer Portal → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=1234567890123456

# Graph API version — update periodically
WA_API_VERSION=v20.0

# Optional: approved template name for business-initiated messages
# (required when client has NOT messaged you first in the last 24h)
# Create template in Meta Business Manager → WhatsApp → Message Templates
WA_TEMPLATE_NAME=appointment_notify

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://rcldmmanvvtkkrbwpkgk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Webhook security ──────────────────────────────────────────────────────
# Shared secret between this service and Supabase DB settings.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then run in Supabase SQL editor:
#   alter database postgres set "app.notify_webhook_secret" = 'YOUR_SECRET';
WEBHOOK_SECRET=change-me-to-a-random-secret

# ── Email (optional) ──────────────────────────────────────────────────────
# Get API key from https://resend.com/api-keys (free: 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxx

# Must be a verified domain/email in Resend
NOTIFY_FROM_EMAIL=noreply@tudominio.com

# ── Misc ──────────────────────────────────────────────────────────────────
DEFAULT_TZ=America/Monterrey
